rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false;
      
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email'])
          && data.uid == request.auth.uid
          && data.email is string && data.email.size() <= 100
          && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
          && (data.isCorporate == null || data.isCorporate is bool)
          && (data.monthlyIncome == null || data.monthlyIncome is number)
          && (data.currency == null || data.currency is string)
          && (data.categories == null || (data.categories is list && data.categories.size() <= 50));
      }
    }

    // Expenses
    match /expenses/{expenseId} {
      allow get, list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidExpense(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidExpense(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      function isValidExpense(data) {
        return data.keys().hasAll(['userId', 'amount', 'category', 'date'])
          && data.userId == request.auth.uid
          && data.amount is number && data.amount >= 0
          && data.category is string && data.category.size() <= 64
          && data.date is string
          && (data.description == null || data.description is string)
          && (data.currency == null || data.currency is string)
          && (data.createdAt == null || data.createdAt is timestamp)
          && (data.merchant == null || (data.merchant is string && data.merchant.size() <= 128))
          && (data.isCorporate == null || data.isCorporate is bool);
      }
    }

    // Reports
    match /reports/{reportId} {
      allow get, list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
