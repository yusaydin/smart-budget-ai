rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false;
      
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email'])
          && data.uid == request.auth.uid
          && data.email is string && data.email.size() <= 100
          && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
          && (!('isCorporate' in data) || data.isCorporate == null || data.isCorporate is bool)
          && (!('monthlyIncome' in data) || data.monthlyIncome == null || data.monthlyIncome is number)
          && (!('currency' in data) || data.currency == null || data.currency is string)
          && (!('categories' in data) || data.categories == null || (data.categories is list && data.categories.size() <= 50))
          && (!('syncLabels' in data) || data.syncLabels == null || data.syncLabels is string)
          && (!('syncFrequency' in data) || data.syncFrequency == null || data.syncFrequency is string)
          && (!('processedEmailIds' in data) || data.processedEmailIds == null || (data.processedEmailIds is list && data.processedEmailIds.size() <= 1000))
          && (!('budgets' in data) || data.budgets == null || data.budgets is map);
      }
    }

    // Expenses
    match /expenses/{expenseId} {
      allow get, list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidExpense(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidExpense(incoming());
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      function isValidExpense(data) {
        return data.keys().hasAll(['userId', 'amount', 'category', 'date'])
          && data.userId == request.auth.uid
          && data.amount is number && data.amount >= 0
          && data.category is string && data.category.size() <= 64
          && data.date is string
          && (!('description' in data) || data.description == null || data.description is string)
          && (!('currency' in data) || data.currency == null || data.currency is string)
          && (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp)
          && (!('merchant' in data) || data.merchant == null || (data.merchant is string && data.merchant.size() <= 128))
          && (!('isCorporate' in data) || data.isCorporate == null || data.isCorporate is bool)
          && (!('isRecurring' in data) || data.isRecurring == null || data.isRecurring is bool)
          && (!('recurrenceInterval' in data) || data.recurrenceInterval == null || data.recurrenceInterval is string)
          && (!('nextRecurrenceDate' in data) || data.nextRecurrenceDate == null || data.nextRecurrenceDate is string)
          && (!('parentId' in data) || data.parentId == null || data.parentId is string);
      }
    }

    // Reports
    match /reports/{reportId} {
      allow get, list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
